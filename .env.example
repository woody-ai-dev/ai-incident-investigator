# Local JSONL source. Set this to your captured incident log file.
INVESTIGATOR_LOG_PATH=data/logs.jsonl

# Enable incident generation with real, billable OpenAI API requests.
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# Optional Actuator target. Configure all three values together.
ACTUATOR_URL=
ACTUATOR_SERVICE=
ACTUATOR_ENVIRONMENT=

# Optional Prometheus source for local development.
# Leave unset to investigate logs only.
# PROMETHEUS_URL=http://127.0.0.1:9090

# Optional persistence for a backend running on the host.
# Start PostgreSQL with the persistence Compose overlay before enabling this.
# DATABASE_URL=postgresql+psycopg://investigator:local-demo-only@127.0.0.1:5433/investigator

# Optional Qdrant connection for the explicit knowledge index/search CLI.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
